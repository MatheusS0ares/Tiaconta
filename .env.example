# Copie para .env.local e preencha. Nunca commite .env / .env.local.
# Local: os valores aparecem em `npx supabase status`.

# Públicas (vão para o browser)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# URL pública do app (links mágicos e convites)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SÓ SERVIDOR — nunca use NEXT_PUBLIC_ nem importe em componente client.
# Ignora RLS: usar só quando RLS realmente não resolve (CLAUDE.md, regra 3).
SUPABASE_SERVICE_ROLE_KEY=
