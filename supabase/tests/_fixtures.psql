-- Agenda de hoje: almoço "Comeu tudo" para toda a turma A1 e B1 (registrado
-- pelas professoras), mural nas duas turmas e um registro de campo oculto
-- para o responsável na criança a1.
select testes.entrar('aaaaaaaa-0000-0000-0000-000000000002');
select registrar_em_lote('aaaaaaaa-2222-0000-0000-000000000001', current_date,
  (select id from agenda_campos where escola_id = 'aaaaaaaa-1111-0000-0000-000000000000' and chave = 'almoco'),
  '{"opcao": "Comeu tudo"}');
insert into turma_dias (escola_id, turma_id, data, mural) values
  ('aaaaaaaa-1111-0000-0000-000000000000', 'aaaaaaaa-2222-0000-0000-000000000001', current_date, 'Mural A1');
select testes.entrar('bbbbbbbb-0000-0000-0000-000000000002');
select registrar_em_lote('bbbbbbbb-2222-0000-0000-000000000001', current_date,
  (select id from agenda_campos where escola_id = 'bbbbbbbb-1111-0000-0000-000000000000' and chave = 'almoco'),
  '{"opcao": "Comeu tudo"}');
insert into turma_dias (escola_id, turma_id, data, mural) values
  ('bbbbbbbb-1111-0000-0000-000000000000', 'bbbbbbbb-2222-0000-0000-000000000001', current_date, 'Mural B1');
select testes.sair();

update agenda_campos set visivel_responsavel = false
where escola_id = 'aaaaaaaa-1111-0000-0000-000000000000' and chave = 'medicacao';
insert into agenda_registros (escola_id, agenda_dia_id, campo_id, valor, registrado_por)
select d.escola_id, d.id, c.id, '{"hora": "10:00", "obs": "interno"}', 'aaaaaaaa-0000-0000-0000-000000000002'
from agenda_dias d
join agenda_campos c on c.escola_id = d.escola_id and c.chave = 'medicacao'
where d.crianca_id = 'aaaaaaaa-3333-0000-0000-000000000001' and d.data = current_date;
