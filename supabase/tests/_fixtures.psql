-- _fixtures.psql — incluído por cada teste com \ir (não é um teste: extensão
-- diferente de .sql). Roda dentro da transação do teste e é desfeito no rollback.
--
-- Escola A                                   Escola B
--   gestor_a, prof_a, prof_a2                  gestor_b, prof_b
--   pai_a1 → crianca a1   pai_a2 → crianca a2
--   turma A1 (bercario): a1, a2, a3           turma B1: b1

create extension if not exists pgtap with schema extensions;

create schema if not exists testes;

-- Atua como usuário autenticado (auth.uid() = p_user) com RLS valendo.
create or replace function testes.entrar(p_user uuid) returns void language plpgsql as $$
begin
  perform set_config('request.jwt.claims',
    json_build_object('sub', p_user, 'role', 'authenticated')::text, true);
  perform set_config('request.jwt.claim.sub', p_user::text, true);
  execute 'set local role authenticated';
end $$;

-- Volta a ser o dono do banco (RLS ignorado) para preparar/conferir dados.
create or replace function testes.sair() returns void language plpgsql as $$
begin
  execute 'reset role';
  perform set_config('request.jwt.claims', '', true);
  perform set_config('request.jwt.claim.sub', '', true);
end $$;

grant usage on schema testes to authenticated;
grant execute on all functions in schema testes to authenticated;

